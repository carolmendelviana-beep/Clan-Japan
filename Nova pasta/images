.hero {
    min-height: 100vh;

    display: flex;
    align-items: center;
    justify-content: center;

    text-align: center;

    position: relative;
    overflow: hidden;

    background:
        radial-gradient(
            circle at 50% 45%,
            rgba(255, 0, 60, 0.18),
            transparent 25%
        ),
        radial-gradient(
            circle at 20% 80%,
            rgba(120, 0, 255, 0.12),
            transparent 30%
        ),
        #000;

    animation: fundoAnimado 8s ease-in-out infinite alternate;
}